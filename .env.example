# Local MySQL used by Prisma. In the managed Webdev runtime, DATABASE_URL is supplied by the project.
DATABASE_URL=mysql://root:password@localhost:3306/teamflow

# Optional for local development only. Managed runtime derives an app-specific key from MANUS_JWT_SECRET.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional; the server defaults to 3000 (Preview/runtime port).
PORT=3000
NODE_ENV=development
