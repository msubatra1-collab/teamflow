{
  "name": "teamflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/src/index.ts",
    "build": "npm run prisma:generate && npm run typecheck && npm run build:server && vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "node --env-file-if-exists=.env scripts/with-mysql-tls.mjs prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env scripts/with-mysql-tls.mjs prisma migrate deploy",
    "prisma:dev": "node --env-file-if-exists=.env scripts/with-mysql-tls.mjs prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env scripts/with-mysql-tls.mjs tsx prisma/seed.ts",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env scripts/with-mysql-tls.mjs tsx scripts/smoke-test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
